{
  "name": "brandbase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:smoke": "node scripts/smoke-routes.mjs",
    "quality": "npm run lint && npm run build && npm run check:sitemap && npm run check:smoke",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:smoke": "npm run lint && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tabler/icons-react": "^3.50.0",
    "@upstash/redis": "^1.40.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.35.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "agentation": "^3.1.2",
    "autoprefixer": "^10.6.2",
    "babel-plugin-react-compiler": "1.0.0",
    "critters": "npm:beasties@^0.5.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.3",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.4.3"
  },
  "browserslist": {
    "production": [
      "chrome >= 109",
      "edge >= 109",
      "firefox >= 115",
      "safari >= 16.4",
      "ios_saf >= 16.4"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "postcss": "^8.5.32"
  },
  "allowScripts": {
    "unrs-resolver@1.11.1": true,
    "esbuild@0.28.1": true,
    "sharp@0.35.5": true
  }
}
