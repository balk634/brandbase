{
  "name": "brandbase",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:smoke": "node scripts/smoke-routes.mjs",
    "quality": "npm run lint && npm run build && npm run check:sitemap && npm run check:smoke",
    "test": "npm run test:unit && npm run test:smoke",
    "test:unit": "tsx --test tests/**/*.test.ts",
    "test:smoke": "npm run lint && npm run build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@tabler/icons-react": "^3.41.1",
    "@upstash/redis": "^1.37.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.21",
    "next": "^16.2.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.10.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agentation": "^3.0.2",
    "autoprefixer": "^10.4.23",
    "babel-plugin-react-compiler": "1.0.0",
    "critters": "^0.0.25",
    "eslint": "^9",
    "eslint-config-next": "^16.1.6",
    "lighthouse": "^13.1.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@next/swc-win32-x64-msvc": "^16.2.2"
  },
  "browserslist": [
    "chrome >= 109",
    "edge >= 109",
    "firefox >= 115",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "lighthouse": {
      "ws": "^7.5.11"
    },
    "@opentelemetry/core": "^2.8.0"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.11.1": true,
    "esbuild@0.28.1": true
  }
}
